- name: bpf_pos
  id: band_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: Filtro passa-faixa em +Δf (slope)
    decim: '1'
    gain: '1'
    high_cutoff_freq: 5*max_dev
    interp: '1'
    low_cutoff_freq: max_dev
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_ccc
    width: 4*max_dev
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 820
    - 300
    rotation: 0
    state: enabled
- name: bpf_neg
  id: band_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: Filtro passa-faixa em -Δf (slope)
    decim: '1'
    gain: '1'
    high_cutoff_freq: -max_dev
    interp: '1'
    low_cutoff_freq: -5*max_dev
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_ccc
    width: 4*max_dev
