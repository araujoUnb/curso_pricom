options:
  parameters:
    author: 'Prof. Daniel Costa Araújo'
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Prática 07 - Ruído em Demoduladores AM e FM'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: pratica_07_ruido_am_fm
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Prática 07 - Ruído em Demoduladores AM e FM'
    window_size: (1280,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
# ============================================
# VARIÁVEIS
# ============================================
- name: samp_rate
  id: variable
  parameters:
    comment: 'Taxa de amostragem (FM)'
    value: '480000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 160]
    rotation: 0
    state: enabled

- name: audio_rate
  id: variable
  parameters:
    comment: 'Taxa de amostragem (áudio/AM)'
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 260]
    rotation: 0
    state: enabled

- name: fc
  id: variable
  parameters:
    comment: 'Frequência da portadora'
    value: '10000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 360]
    rotation: 0
    state: enabled

- name: fm
  id: variable
  parameters:
    comment: 'Frequência da mensagem'
    value: '1000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 460]
    rotation: 0
    state: enabled

- name: max_dev
  id: variable
  parameters:
    comment: 'Desvio máximo de frequência FM'
    value: '10000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 560]
    rotation: 0
    state: enabled

# ============================================
# SLIDERS (QT GUI Range)
# ============================================
- name: noise_sigma
  id: variable_qtgui_range
  parameters:
    comment: 'Amplitude do ruído AWGN'
    gui_hint: 0,0,1,2
    label: 'Noise Sigma'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.05'
    stop: '1.0'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled

# ============================================
# CADEIA AM - FONTES DE SINAL
# ============================================
# Mensagem AM: cos(2*pi*fm*t)
- name: src_mensagem_am
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1.0'
    comment: 'Sinal mensagem AM m(t)'
    freq: fm
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: audio_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 260]
    rotation: 0
    state: enabled

# Portadora AM: cos(2*pi*fc*t)
- name: src_portadora_am
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1.0'
    comment: 'Portadora AM c(t)'
    freq: fc
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: audio_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 420]
    rotation: 0
    state: enabled

# Oscilador local AM: cos(2*pi*fc*t)
- name: src_local_am
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1.0'
    comment: 'Oscilador local AM (demod)'
    freq: fc
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: audio_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 500]
    rotation: 0
    state: enabled

# ============================================
# CADEIA AM - MODULADOR: Multiply (mensagem × portadora)
# ============================================
- name: mult_mod_am
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Modulação AM DSB-SC: m(t) × c(t)'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 340]
    rotation: 0
    state: enabled

# ============================================
# CADEIA AM - CANAL AWGN
# ============================================
- name: noise_am
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: noise_sigma
    comment: 'Ruído AWGN (AM)'
    noise_type: analog.GR_GAUSSIAN
    seed: '0'
    type: float
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 460]
    rotation: 0
    state: enabled

- name: add_am
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'AM + ruído'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 380]
    rotation: 0
    state: enabled

# ============================================
# CADEIA AM - DEMODULADOR: Multiply (sinal ruidoso × oscilador local)
# ============================================
- name: mult_demod_am
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Demodulação AM: r(t) × cos(2πfc·t)'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [700, 440]
    rotation: 0
    state: enabled

# ============================================
# CADEIA AM - FILTRO PASSA-BAIXAS
# ============================================
- name: lpf_am
  id: low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'Filtro passa-baixas AM'
    cutoff_freq: '1500'
    decim: '1'
    gain: '1'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: audio_rate
    type: fir_filter_fff
    width: '300'
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 420]
    rotation: 0
    state: enabled

# ============================================
# CADEIA AM - THROTTLE
# ============================================
- name: throttle_am
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: 'Throttle AM'
    ignoretag: 'True'
    limit: auto
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: audio_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 440]
    rotation: 0
    state: enabled

# ============================================
# CADEIA FM - FONTE DE SINAL
# ============================================
# Mensagem FM: cos(2*pi*fm*t)
- name: src_mensagem_fm
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1.0'
    comment: 'Sinal mensagem FM m(t)'
    freq: fm
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: audio_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 700]
    rotation: 0
    state: enabled

# ============================================
# CADEIA FM - MODULADOR WBFM
# ============================================
- name: wfm_tx
  id: analog_wfm_tx
  parameters:
    affinity: ''
    alias: ''
    audio_rate: audio_rate
    comment: 'Modulador WBFM'
    fh: '-1.0'
    max_dev: max_dev
    maxoutbuf: '0'
    minoutbuf: '0'
    quad_rate: samp_rate
    tau: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 720]
    rotation: 0
    state: enabled

# ============================================
# CADEIA FM - THROTTLE
# ============================================
- name: throttle_fm
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: 'Throttle FM'
    ignoretag: 'True'
    limit: auto
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 740]
    rotation: 0
    state: enabled

# ============================================
# CADEIA FM - CANAL AWGN
# ============================================
- name: noise_fm
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: noise_sigma
    comment: 'Ruído AWGN (FM, Complex)'
    noise_type: analog.GR_GAUSSIAN
    seed: '0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 860]
    rotation: 0
    state: enabled

- name: add_fm
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'FM + ruído'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [740, 780]
    rotation: 0
    state: enabled

# ============================================
# CADEIA FM - DEMODULADOR WBFM
# ============================================
- name: wfm_rcv
  id: analog_wfm_rcv
  parameters:
    affinity: ''
    alias: ''
    audio_decimation: '10'
    comment: 'Demodulador WBFM'
    maxoutbuf: '0'
    minoutbuf: '0'
    quad_rate: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 760]
    rotation: 0
    state: enabled

# ============================================
# VISUALIZAÇÃO: Osciloscópio (Time Sink)
# ============================================
- name: time_sink
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'True'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: 2,0,1,2
    label1: 'Mensagem original'
    label10: Signal 10
    label2: 'AM demodulado'
    label3: 'FM demodulado'
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"Comparação AM vs FM"'
    nconnections: '3'
    size: '1024'
    srate: audio_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: Amplitude
    ymax: '1.5'
    ymin: '-1.5'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1100, 600]
    rotation: 0
    state: enabled

connections:
# ============================================
# CADEIA AM
# ============================================
# Modulador AM: mensagem × portadora
- [src_mensagem_am, '0', mult_mod_am, '0']
- [src_portadora_am, '0', mult_mod_am, '1']
# Canal AWGN AM: sinal modulado + ruído
- [mult_mod_am, '0', add_am, '0']
- [noise_am, '0', add_am, '1']
# Demodulador AM: sinal ruidoso × oscilador local
- [add_am, '0', mult_demod_am, '0']
- [src_local_am, '0', mult_demod_am, '1']
# Filtro passa-baixas AM
- [mult_demod_am, '0', lpf_am, '0']
# Throttle AM (após LPF)
- [lpf_am, '0', throttle_am, '0']

# ============================================
# CADEIA FM
# ============================================
# Modulador FM: mensagem → WBFM Transmit
- [src_mensagem_fm, '0', wfm_tx, '0']
# Throttle FM (após WBFM Transmit)
- [wfm_tx, '0', throttle_fm, '0']
# Canal AWGN FM: sinal FM + ruído
- [throttle_fm, '0', add_fm, '0']
- [noise_fm, '0', add_fm, '1']
# Demodulador FM: WBFM Receive
- [add_fm, '0', wfm_rcv, '0']

# ============================================
# VISUALIZAÇÃO: Time Sink (3 canais)
# ============================================
# Canal 0: Mensagem original (da fonte AM)
- [src_mensagem_am, '0', time_sink, '0']
# Canal 1: AM demodulado (após throttle AM)
- [throttle_am, '0', time_sink, '1']
# Canal 2: FM demodulado
- [wfm_rcv, '0', time_sink, '2']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
