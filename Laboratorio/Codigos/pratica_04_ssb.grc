options:
  parameters:
    author: 'Prof. Daniel Costa Araújo'
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Prática 04 - Modulação SSB (Banda Lateral Única)'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: pratica_04_ssb
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Prática 04 - Modulação SSB (Banda Lateral Única)'
    window_size: (1280,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
# ============================================
# VARIÁVEIS
# ============================================
- name: samp_rate
  id: variable
  parameters:
    comment: 'Taxa de amostragem'
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 160]
    rotation: 0
    state: enabled

- name: fc
  id: variable
  parameters:
    comment: 'Frequência da portadora'
    value: '12000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 260]
    rotation: 0
    state: enabled

# ============================================
# SLIDERS (QT GUI Range)
# ============================================
- name: fm
  id: variable_qtgui_range
  parameters:
    comment: 'Frequência da mensagem'
    gui_hint: 0,0,1,2
    label: 'Frequência mensagem fm (Hz)'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '500'
    step: '500'
    stop: '5000'
    value: '2000'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled

# ============================================
# FONTES DE SINAL
# ============================================
# Mensagem: cos(2*pi*fm*t)
- name: src_mensagem
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1.0'
    comment: 'Sinal mensagem m(t)'
    freq: fm
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 260]
    rotation: 0
    state: enabled

# Portadora: cos(2*pi*fc*t)
- name: src_portadora
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1.0'
    comment: 'Portadora c(t)'
    freq: fc
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 420]
    rotation: 0
    state: enabled

# Oscilador local para demodulação: cos(2*pi*fc*t), amplitude 2.0
- name: src_local
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '2.0'
    comment: 'Oscilador local (demod) amp=2'
    freq: fc
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 560]
    rotation: 0
    state: enabled

# ============================================
# MODULADOR: Multiply (mensagem × portadora) -> DSB-SC
# ============================================
- name: mult_mod
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Modulação DSB-SC: m(t) × c(t)'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 340]
    rotation: 0
    state: enabled

# ============================================
# THROTTLE
# ============================================
- name: throttle
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 340]
    rotation: 0
    state: enabled

# ============================================
# FILTRO PASSA-BANDA USB (Band Pass Filter)
# ============================================
- name: bpf_usb
  id: band_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'Filtro USB: seleciona banda lateral superior'
    decim: '1'
    gain: '1'
    high_cutoff_freq: fc+fm+1000
    interp: '1'
    low_cutoff_freq: fc+100
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_fff
    width: '500'
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 260]
    rotation: 0
    state: enabled

# ============================================
# FILTRO PASSA-BANDA LSB (Band Pass Filter)
# ============================================
- name: bpf_lsb
  id: band_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'Filtro LSB: seleciona banda lateral inferior'
    decim: '1'
    gain: '1'
    high_cutoff_freq: fc-100
    interp: '1'
    low_cutoff_freq: fc-fm-1000
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_fff
    width: '500'
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 440]
    rotation: 0
    state: enabled

# ============================================
# DEMODULADOR: Multiply (USB × oscilador local)
# ============================================
- name: mult_demod
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Demodulação: USB × osc. local'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 620]
    rotation: 0
    state: enabled

# ============================================
# FILTRO PASSA-BAIXAS (demodulação)
# ============================================
- name: lpf
  id: low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'Filtro passa-baixas para recuperar m(t)'
    cutoff_freq: fm*1.5
    decim: '1'
    gain: '1'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_fff
    width: '400'
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [900, 600]
    rotation: 0
    state: enabled

# ============================================
# VISUALIZAÇÃO: Espectro modulado/filtrado (Freq Sink - 3 conexões)
# ============================================
- name: freq_sink_mod
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '1.0'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '4096'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 2,0,1,1
    label: Relative Gain
    label1: 'DSB-SC'
    label10: ''''''
    label2: 'USB'
    label3: 'LSB'
    label4: ''''''
    label5: ''''''
    label6: ''''''
    label7: ''''''
    label8: ''''''
    label9: ''''''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Espectro Modulado / Filtrado"'
    nconnections: '3'
    norm_window: 'False'
    showports: 'False'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_HANN
    ymax: '10'
    ymin: '-100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1100, 300]
    rotation: 0
    state: enabled

# ============================================
# VISUALIZAÇÃO: Domínio do Tempo (Time Sink - 2 conexões)
# ============================================
- name: time_sink
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'True'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: 2,1,1,1
    label1: 'Mensagem original'
    label10: Signal 10
    label2: 'Sinal demodulado'
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"Domínio do Tempo"'
    nconnections: '2'
    size: '1024'
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: Amplitude
    ymax: '1.5'
    ymin: '-1.5'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1100, 520]
    rotation: 0
    state: enabled

# ============================================
# VISUALIZAÇÃO: Espectro do sinal demodulado (Freq Sink)
# ============================================
- name: freq_sink_demod
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '1.0'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '4096'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 3,0,1,2
    label: Relative Gain
    label1: 'Sinal demodulado'
    label10: ''''''
    label2: ''''''
    label3: ''''''
    label4: ''''''
    label5: ''''''
    label6: ''''''
    label7: ''''''
    label8: ''''''
    label9: ''''''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Espectro do Sinal Demodulado"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_HANN
    ymax: '10'
    ymin: '-100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1100, 740]
    rotation: 0
    state: enabled

connections:
# Modulador: mensagem × portadora -> DSB-SC
- [src_mensagem, '0', mult_mod, '0']
- [src_portadora, '0', mult_mod, '1']
# Throttle
- [mult_mod, '0', throttle, '0']
# Filtros passa-banda USB e LSB
- [throttle, '0', bpf_usb, '0']
- [throttle, '0', bpf_lsb, '0']
# Demodulador: USB × oscilador local
- [bpf_usb, '0', mult_demod, '0']
- [src_local, '0', mult_demod, '1']
# Filtro passa-baixas
- [mult_demod, '0', lpf, '0']
# Espectro modulado/filtrado: DSB-SC, USB, LSB (3 conexões)
- [throttle, '0', freq_sink_mod, '0']
- [bpf_usb, '0', freq_sink_mod, '1']
- [bpf_lsb, '0', freq_sink_mod, '2']
# Domínio do tempo: mensagem original e sinal demodulado
- [src_mensagem, '0', time_sink, '0']
- [lpf, '0', time_sink, '1']
# Espectro do sinal demodulado
- [lpf, '0', freq_sink_demod, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
