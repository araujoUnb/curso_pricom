connections:
# Fonte -> Throttle
- [src_sinal, '0', throttle, '0']
# Throttle -> Visualização do sinal original
- [throttle, '0', time_sink_original, '0']
- [throttle, '0', freq_sink_original, '0']
# Caminho sem filtro: Throttle -> Keep 1 in N -> Sinks decimados
- [throttle, '0', keep_1_in_n_sem_filtro, '0']
- [keep_1_in_n_sem_filtro, '0', time_sink_decim, '0']
- [keep_1_in_n_sem_filtro, '0', freq_sink_decim, '0']
# Caminho com filtro AA: Throttle -> LPF -> Keep 1 in N -> Sinks decimados
- [throttle, '0', lpf_aa, '0']
- [lpf_aa, '0', keep_1_in_n_com_filtro, '0']
- [keep_1_in_n_com_filtro, '0', time_sink_decim, '1']
- [keep_1_in_n_com_filtro, '0', freq_sink_decim, '1']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
