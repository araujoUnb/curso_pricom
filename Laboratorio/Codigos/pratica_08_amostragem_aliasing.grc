# ============================================
# VISUALIZAÇÃO: Sinais Decimados - Espectro
# ============================================
- name: freq_sink_decim
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
