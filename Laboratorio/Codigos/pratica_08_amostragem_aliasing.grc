options:
  parameters:
    author: 'Prof. Daniel Costa Araújo'
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Prática 08 - Amostragem e Aliasing'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: pratica_08_amostragem_aliasing
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Prática 08 - Amostragem e Aliasing'
    window_size: (1280,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
# ============================================
# VARIÁVEIS
# ============================================
- name: samp_rate
  id: variable
  parameters:
    comment: 'Taxa de amostragem'
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 160]
    rotation: 0
    state: enabled

- name: fs_eff
  id: variable
  parameters:
    comment: 'Taxa de amostragem efetiva após decimação'
    value: 'samp_rate/decim'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 260]
    rotation: 0
    state: enabled

# ============================================
# SLIDERS (QT GUI Range)
# ============================================
- name: decim
  id: variable_qtgui_range
  parameters:
    comment: 'Fator de decimação'
    gui_hint: 0,0,1,1
    label: 'Fator de decimação (decim)'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '2'
    step: '1'
    stop: '20'
    value: '4'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled

- name: f_sinal
  id: variable_qtgui_range
  parameters:
    comment: 'Frequência do sinal de entrada'
    gui_hint: 0,1,1,1
    label: 'Frequência do sinal (Hz)'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '500'
    step: '500'
    stop: '20000'
    value: '1000'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [450, 12]
    rotation: 0
    state: enabled

# ============================================
# FONTE DE SINAL
# ============================================
- name: src_sinal
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1.0'
    comment: 'Sinal senoidal x(t) = cos(2*pi*f_sinal*t)'
    freq: f_sinal
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 300]
    rotation: 0
    state: enabled

# ============================================
# THROTTLE
# ============================================
- name: throttle
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 340]
    rotation: 0
    state: enabled

# ============================================
# DECIMAÇÃO SEM FILTRO (Keep 1 in N)
# ============================================
- name: keep_1_in_n_sem_filtro
  id: blocks_keep_one_in_n
  parameters:
    affinity: ''
    alias: ''
    comment: 'Decimação sem filtro anti-aliasing'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: decim
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 340]
    rotation: 0
    state: enabled

# ============================================
# FILTRO ANTI-ALIASING (Low Pass Filter)
# ============================================
- name: lpf_aa
  id: low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'Filtro anti-aliasing antes da decimação'
    cutoff_freq: fs_eff/2*0.9
    decim: '1'
    gain: '1'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_fff
    width: '200'
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 480]
    rotation: 0
    state: enabled

# ============================================
# DECIMAÇÃO COM FILTRO (Keep 1 in N)
# ============================================
- name: keep_1_in_n_com_filtro
  id: blocks_keep_one_in_n
  parameters:
    affinity: ''
    alias: ''
    comment: 'Decimação com filtro anti-aliasing'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: decim
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 520]
    rotation: 0
    state: enabled

# ============================================
# VISUALIZAÇÃO: Sinal Original - Tempo
# ============================================
- name: time_sink_original
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'True'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: 2,0,1,1
    label1: 'Sinal original'
    label10: Signal 10
    label2: Signal 2
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"Sinal Original (Tempo)"'
    nconnections: '1'
    size: '1024'
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: Amplitude
    ymax: '1.5'
    ymin: '-1.5'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 180]
    rotation: 0
    state: enabled

# ============================================
# VISUALIZAÇÃO: Sinal Original - Espectro
# ============================================
- name: freq_sink_original
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '1.0'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '4096'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 2,1,1,1
    label: Relative Gain
    label1: 'Sinal original'
    label10: ''''''
    label2: ''''''
    label3: ''''''
    label4: ''''''
    label5: ''''''
    label6: ''''''
    label7: ''''''
    label8: ''''''
    label9: ''''''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Espectro Original"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    type: float
    update_time: '0.10'
    width1: '1'
