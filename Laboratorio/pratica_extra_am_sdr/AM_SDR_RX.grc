- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Desenrola a fase e divide por 2 (recuperacao de portadora via quadrado)\"\
      \"\"\n    def __init__(self):\n        gr.sync_block.__init__(\n           \
      \ self,\n            name='Unwrap e Divide por 2',\n            in_sig=[np.complex64],\
      \   # saida do PLL Carrier Regeneration (em 2*theta)\n            out_sig=[np.complex64]\
      \   # portadora reconstruida (em theta)\n        )\n        self.fase_anterior\
      \ = 0.0\n        self.acumulado = 0.0\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0]\n        y = output_items[0]\n        fase_ant =\
      \ self.fase_anterior\n        acumulado = self.acumulado\n\n        for n in\
      \ range(len(x)):\n            fase_bruta = np.angle(x[n])\n            diferenca\
      \ = fase_bruta - fase_ant\n\n            if diferenca > np.pi:\n           \
      \     acumulado -= 2*np.pi\n            elif diferenca < -np.pi:\n         \
      \       acumulado += 2*np.pi\n\n            fase_continua = fase_bruta + acumulado\n\
      \            fase_ant = fase_bruta\n\n            theta = fase_continua / 2.0\n\
      \            y[n] = np.exp(1j*theta)\n\n        self.fase_anterior = fase_ant\n\
      \        self.acumulado = acumulado\n        return len(output_items[0])"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Unwrap e Divide por 2', 'blk', [], [('0', 'complex', 1)], [('0',
      'complex', 1)], 'Desenrola a fase e divide por 2 (recuperacao de portadora via
      quadrado)', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1160, 240.0]
    rotation: 0
    state: enabled
