options:
  parameters:
    author: 'Prof. Daniel Costa Araújo'
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Prática 04 - Modulação SSB (Banda Lateral Única)'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: pratica_04_ssb
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Prática 04 - Modulação SSB (Banda Lateral Única)'
    window_size: (1400,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
# ============================================
# VARIÁVEIS
# ============================================
- name: samp_rate
  id: variable
  parameters:
    comment: 'Taxa de amostragem'
    value: '64000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 140]
    rotation: 0
    state: enabled

- name: fc
  id: variable
  parameters:
    comment: 'Frequência da portadora'
    value: '16000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 212]
    rotation: 0
    state: enabled

- name: bw_trans
  id: variable
  parameters:
    comment: 'Banda de transição dos BPF'
    value: '800'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [104, 140]
    rotation: 0
    state: enabled

- name: bw_trans_lp
  id: variable
  parameters:
    comment: 'Banda de transição do LPF'
    value: '600'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [104, 212]
    rotation: 0
    state: enabled

- name: n_hilb
  id: variable
  parameters:
    comment: 'Coeficientes do filtro de Hilbert (ímpar)'
    value: '101'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [216, 140]
    rotation: 0
    state: enabled

# Atraso de grupo acumulado do caminho de demodulação:
#   BPF (193 taps -> 96) + LPF (257 taps -> 128) = 224 amostras.
# Depende apenas de bw_trans e bw_trans_lp, portanto é constante
# para qualquer posição do slider fm.
- name: d_align
  id: variable
  parameters:
    comment: 'Atraso de grupo BPF + LPF (amostras)'
    value: '224'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [216, 212]
    rotation: 0
    state: enabled

# ============================================
# CONTROLES (QT GUI Range)
# ============================================
- name: fm
  id: variable_qtgui_range
  parameters:
    comment: 'Frequência da mensagem'
    gui_hint: 0,0,1,1
    label: 'Frequência da mensagem fm (Hz)'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '1500'
    step: '500'
    stop: '6000'
    value: '3000'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 12]
    rotation: 0
    state: enabled

# Erro de frequência do oscilador local (Etapa 4b / Q4)
- name: delta_f
  id: variable_qtgui_range
  parameters:
    comment: 'Erro de frequência do oscilador local'
    gui_hint: 0,1,1,1
    label: 'Erro do oscilador local delta_f (Hz)'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-500'
    step: '25'
    stop: '500'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 12]
    rotation: 0
    state: enabled

# ============================================
# FONTES DE SINAL
# ============================================
# Mensagem: cos(2*pi*fm*t)
- name: src_mensagem
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1.0'
    comment: 'Sinal mensagem m(t)'
    freq: fm
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 316]
    rotation: 0
    state: enabled

# Portadora em fase: cos(2*pi*fc*t)
- name: src_portadora_cos
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1.0'
    comment: 'Portadora em fase cos(2 pi fc t)'
    freq: fc
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 436]
    rotation: 0
    state: enabled

# Portadora em quadratura: sin(2*pi*fc*t) - usada só no método de Hilbert
- name: src_portadora_sin
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1.0'
    comment: 'Portadora em quadratura sin(2 pi fc t)'
    freq: fc
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_SIN_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 852]
    rotation: 0
    state: enabled

# Oscilador local da demodulação: 2*cos(2*pi*(fc + delta_f)*t)
- name: src_local
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '2.0'
    comment: 'Oscilador local: fc + delta_f, amplitude 2'
    freq: fc+delta_f
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 660]
    rotation: 0
    state: enabled

# ============================================
# ETAPA 1 - MODULADOR DSB-SC: m(t) x cos(2 pi fc t)
# ============================================
- name: mult_mod
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'DSB-SC: m(t) x c(t)'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [312, 352]
    rotation: 0
    state: enabled

- name: throttle
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [456, 360]
    rotation: 0
    state: enabled

# ============================================
# ETAPA 2 - FILTRO PASSA-BANDA USB
# ============================================
- name: bpf_usb
  id: band_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'Etapa 2: seleciona a banda lateral superior'
    decim: '1'
    gain: '1'
    high_cutoff_freq: fc+2*fm
    interp: '1'
    low_cutoff_freq: fc+fm/2
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_fff
    width: bw_trans
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 252]
    rotation: 0
    state: enabled

# ============================================
# ETAPA 3 - FILTRO PASSA-BANDA LSB
# ============================================
- name: bpf_lsb
  id: band_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'Etapa 3: seleciona a banda lateral inferior'
    decim: '1'
    gain: '1'
    high_cutoff_freq: fc-fm/2
    interp: '1'
    low_cutoff_freq: fc-2*fm
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_fff
    width: bw_trans
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 452]
    rotation: 0
    state: enabled

# ============================================
# ETAPA 4 - DEMODULAÇÃO COERENTE DO SSB-USB
# ============================================
- name: mult_demod
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Etapa 4: SSB-USB x oscilador local'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [664, 620]
    rotation: 0
    state: enabled

- name: lpf
  id: low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'Etapa 4: recupera m(t) em banda base'
    cutoff_freq: fm*1.5
    decim: '1'
    gain: '1'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_fff
    width: bw_trans_lp
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 604]
    rotation: 0
    state: enabled

# Atrasa a mensagem de referência para compensar o atraso de grupo
# de BPF + LPF; sem isso as duas curvas do Time Sink aparecem
# deslocadas horizontalmente e a comparação fica prejudicada.
- name: delay_ref
  id: blocks_delay
  parameters:
    affinity: ''
    alias: ''
    comment: 'Alinha m(t) com o sinal demodulado'
    delay: d_align
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    showports: 'False'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 700]
    rotation: 0
    state: enabled

# ============================================
# ETAPA 5 - GERAÇÃO SSB PELA TRANSFORMADA DE HILBERT
# ============================================
# A saída complexa do bloco Hilbert é o sinal analítico
#   m(t - tau) + j*m_chapeu(t - tau),  tau = (n_hilb-1)/2 amostras.
# Os dois ramos saem do MESMO bloco e por isso já estão alinhados:
# usar a mensagem original no ramo em fase destrói o cancelamento.
- name: hilbert
  id: hilbert_fc
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'Sinal analítico da mensagem'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_taps: n_hilb
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 764]
    rotation: 0
    state: enabled

- name: c2f
  id: blocks_complex_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: 're = m(t-tau)   |   im = m_chapeu(t-tau)'
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [448, 764]
    rotation: 0
    state: enabled

- name: mult_i
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Ramo I: m(t-tau) x cos'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 756]
    rotation: 0
    state: enabled

- name: mult_q
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Ramo Q: m_chapeu(t-tau) x sin'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 852]
    rotation: 0
    state: enabled

- name: sub_usb
  id: blocks_sub_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'I - Q  ->  USB'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [792, 764]
    rotation: 0
    state: enabled

- name: add_lsb
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'I + Q  ->  LSB'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [792, 872]
    rotation: 0
    state: enabled

# ============================================
# VISUALIZAÇÃO
# ============================================
- name: freq_sink_mod
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: 'Etapas 1 a 3'
    ctrlpanel: 'True'
    fc: '0'
    fftsize: '4096'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 1,0,1,1
    label: Relative Gain
    label1: 'DSB-SC'
    label10: ''''''
    label2: 'SSB-USB (filtragem)'
    label3: 'SSB-LSB (filtragem)'
    label4: ''''''
    label5: ''''''
    label6: ''''''
    label7: ''''''
    label8: ''''''
    label9: ''''''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Etapas 1-3: DSB-SC e bandas laterais por filtragem"'
    nconnections: '3'
    norm_window: 'False'
    showports: 'False'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_HANN
    ymax: '10'
    ymin: '-120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 300]
    rotation: 0
    state: enabled

- name: freq_sink_hilb
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
