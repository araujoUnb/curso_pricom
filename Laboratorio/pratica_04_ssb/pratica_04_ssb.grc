connections:
# Etapa 1: modulador DSB-SC
- [src_mensagem, '0', mult_mod, '0']
- [src_portadora_cos, '0', mult_mod, '1']
- [mult_mod, '0', throttle, '0']
# Etapas 2 e 3: filtros passa-banda
- [throttle, '0', bpf_usb, '0']
- [throttle, '0', bpf_lsb, '0']
# Etapa 4: demodulação coerente do SSB-USB
- [bpf_usb, '0', mult_demod, '0']
- [src_local, '0', mult_demod, '1']
- [mult_demod, '0', lpf, '0']
- [src_mensagem, '0', delay_ref, '0']
# Etapa 5: método da transformada de Hilbert
- [src_mensagem, '0', hilbert, '0']
- [hilbert, '0', c2f, '0']
- [c2f, '0', mult_i, '0']
- [src_portadora_cos, '0', mult_i, '1']
- [c2f, '1', mult_q, '0']
- [src_portadora_sin, '0', mult_q, '1']
- [mult_i, '0', sub_usb, '0']
- [mult_q, '0', sub_usb, '1']
- [mult_i, '0', add_lsb, '0']
- [mult_q, '0', add_lsb, '1']
# Espectro das etapas 1 a 3
- [throttle, '0', freq_sink_mod, '0']
- [bpf_usb, '0', freq_sink_mod, '1']
- [bpf_lsb, '0', freq_sink_mod, '2']
# Espectro da etapa 5
- [sub_usb, '0', freq_sink_hilb, '0']
- [add_lsb, '0', freq_sink_hilb, '1']
# Domínio do tempo e espectro demodulado
- [delay_ref, '0', time_sink, '0']
- [lpf, '0', time_sink, '1']
- [lpf, '0', freq_sink_demod, '0']

