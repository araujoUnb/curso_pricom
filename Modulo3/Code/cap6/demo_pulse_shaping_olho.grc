    bus_structure: null
    coordinate: [1144, 20.0]
    rotation: 0
    state: enabled
- name: glfsr
  id: digital_glfsr_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: "Bits pseudo-aleat\xF3rios (0/1)"
    degree: '8'
    mask: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    seed: '1'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 220.0]
    rotation: 0
    state: enabled
- name: noise
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: noise_amp
    comment: "Ru\xEDdo gaussiano do canal"
    maxoutbuf: '0'
    minoutbuf: '0'
