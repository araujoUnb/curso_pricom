- [throttle, '0', tx_rrc, '0']
- [tx_rrc, '0', add_canal, '0']
- [tx_rrc, '0', freq_sink_tx, '0']
- [tx_rrc, '0', time_sink_tx, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
