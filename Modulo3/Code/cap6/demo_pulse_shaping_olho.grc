  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [660, 480]
    rotation: 0
    state: enabled
- name: rx_rrc
  id: root_raised_cosine_filter
  parameters:
    affinity: ''
    alias: ''
    alpha: alpha
    comment: Filtro casado RRC -> RRC*RRC = cosseno levantado (ISI nula)
    decim: '1'
    gain: '1'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    ntaps: ntaps
    samp_rate: samp_rate
    sym_rate: sym_rate
