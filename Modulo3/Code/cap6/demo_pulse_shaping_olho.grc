options:
  parameters:
    author: "Prof. Daniel Costa Ara\xFAjo"
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "Formata\xE7\xE3o de pulso (RRC), ISI e diagrama de olho"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: demo_pulse_shaping_olho
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Demo: Formata\xE7\xE3o de Pulso, ISI e Diagrama de Olho"
    window_size: (1280,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: alpha
  id: variable_qtgui_range
  parameters:
    comment: Fator de roll-off do cosseno levantado
    gui_hint: 0,0,1,1
    label: Roll-off alpha
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.0'
    step: '0.05'
    stop: '1.0'
    value: '0.35'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12]
    rotation: 0
    state: enabled
- name: noise_amp
  id: variable_qtgui_range
  parameters:
    comment: "Amplitude do ru\xEDdo do canal (AWGN)"
    gui_hint: 0,1,1,1
    label: "Ru\xEDdo do canal (AWGN)"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.0'
    step: '0.02'
    stop: '0.6'
    value: '0.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 12]
    rotation: 0
    state: enabled
- name: ntaps
  id: variable
  parameters:
    comment: "N\xFAmero de coeficientes do filtro RRC"
    value: 11*sps+1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 120]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Taxa de amostragem (samples/s)
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 120]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: "Amostras por s\xEDmbolo (fixa)"
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 120]
    rotation: 0
    state: enabled
- name: sym_rate
  id: variable
  parameters:
    comment: "Taxa de s\xEDmbolos Rs = samp_rate/sps"
    value: samp_rate/sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 120]
    rotation: 0
    state: enabled
- name: add_canal
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: "Sinal + ru\xEDdo"
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 360]
    rotation: 0
    state: enabled
- name: chunks_to_symbols
  id: digital_chunks_to_symbols_xx
  parameters:
    affinity: ''
    alias: ''
    comment: Mapeia 0 -> -1 e 1 -> +1 (2-PAM)
    dimension: '1'
    in_type: byte
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    out_type: float
    symbol_table: '[-1, 1]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 308]
    rotation: 0
    state: enabled
- name: eye_sink_rx
  id: qtgui_eye_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
