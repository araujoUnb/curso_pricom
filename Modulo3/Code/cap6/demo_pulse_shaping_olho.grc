    comment: "Limita CPU na taxa de s\xEDmbolos"
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: sym_rate
    type: float
    vlen: '1'
  states:
